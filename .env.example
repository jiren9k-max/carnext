# Copy to .env.local (locally) or add in Vercel → Project → Settings → Environment Variables.

# OLX.ba shop whose active car listings are shown on the site (refreshed every 10 min)
OLX_SHOP_USERNAME=CarNextSarajevo

# Contact form email (optional — without these, inquiries are only saved, not emailed)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
CONTACT_EMAIL=info@carnextsarajevo.com
