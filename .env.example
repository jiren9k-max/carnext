# Copy to .env.local (locally) or add in Vercel → Project → Settings → Environment Variables.

# OLX.ba shop whose active car listings are shown on the site (refreshed every 10 min)
OLX_SHOP_USERNAME=CarNextSarajevo

# Contact form email (optional — without these, inquiries are only saved, not emailed)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
CONTACT_EMAIL=info@carnextsarajevo.com

# Public address of the site for Google and link previews, e.g. https://carnextsarajevo.com
# (optional on Vercel: the production address is used automatically until a domain is set)
NEXT_PUBLIC_SITE_URL=

# Admin login — REQUIRED for /admin. Never put real values in this file.
# ADMIN_PASSWORD_HASH: run  node scripts/hash-password.mjs "your-password"  and paste the result.
# SESSION_SECRET: random string of at least 32 characters, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
SESSION_SECRET=
